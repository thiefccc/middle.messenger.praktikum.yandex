{
  "name": "tapresslide",
  "version": "0.1.0",
  "private": true,
  "description": "TaPresSlide — web messenger",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && vite preview --port 3000",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint:ts && npm run lint:eslint && npm run lint:styles",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "handlebars": "^4.7.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "sass": "^1.85.0",
    "stylelint": "^16.15.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix"
    ],
    "*.scss": [
      "stylelint --fix"
    ],
    "*.{ts,tsx,js,cjs,mjs,scss,json,md,html}": [
      "prettier --write"
    ]
  }
}
